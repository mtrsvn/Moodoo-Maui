<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MoodooApp.ViewModels"
             xmlns:models="clr-namespace:MoodooApp.Models"
             x:Class="MoodooApp.Pages.InsightsPage"
             x:DataType="viewmodel:InsightsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,36,20,20" Spacing="0">

            <VerticalStackLayout Margin="0,0,0,20">
                <Label Style="{StaticResource HeaderTitle}" Text="Mood Insights" />
                <Label Style="{StaticResource SubTitle}" Text="{Binding CurrentMonth}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,10,*,10,*" Margin="0,0,0,16">
                <Border Grid.Column="0" Style="{StaticResource SmallCard}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="&#xe85c;" FontFamily="MaterialIcons" FontSize="20" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                        <Label Text="{Binding AverageScore, StringFormat='{0:F1}'}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}" HorizontalOptions="Center" />
                        <Label Text="Avg Score" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SmallCard}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="&#xe8dc;" FontFamily="MaterialIcons" FontSize="20" TextColor="#00E676" HorizontalOptions="Center" />
                        <Label Text="{Binding PositivePercentage, StringFormat='{0}%'}" FontSize="20" FontAttributes="Bold" TextColor="#00E676" HorizontalOptions="Center" />
                        <Label Text="Positive" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource SmallCard}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="&#xe87d;" FontFamily="MaterialIcons" FontSize="20" TextColor="#FFB800" HorizontalOptions="Center" />
                        <Label Text="Happy" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}" HorizontalOptions="Center" />
                        <Label Text="Top Mood" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource SectionTitle}" Text="Weekly Overview" Margin="0" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Last 7 Days" Style="{StaticResource MutedText}" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" HeightRequest="150" Margin="0,10,0,0">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="End" HorizontalOptions="Center" Spacing="6">
                            <Label Text="🙂" FontSize="16" HorizontalOptions="Center" />
                            <Border BackgroundColor="{StaticResource Primary}" HeightRequest="80" WidthRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 6" HorizontalOptions="Center" />
                            <Label Text="Mon" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="End" HorizontalOptions="Center" Spacing="6">
                            <Label Text="😁" FontSize="16" HorizontalOptions="Center" />
                            <Border BackgroundColor="#00E676" HeightRequest="105" WidthRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 6" HorizontalOptions="Center" />
                            <Label Text="Tue" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" VerticalOptions="End" HorizontalOptions="Center" Spacing="6">
                            <Label Text="😐" FontSize="16" HorizontalOptions="Center" />
                            <Border BackgroundColor="#FFB800" HeightRequest="60" WidthRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 6" HorizontalOptions="Center" />
                            <Label Text="Wed" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" VerticalOptions="End" HorizontalOptions="Center" Spacing="6">
                            <Label Text="😁" FontSize="16" HorizontalOptions="Center" />
                            <Border BackgroundColor="#00E676" HeightRequest="105" WidthRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 6" HorizontalOptions="Center" />
                            <Label Text="Thu" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="4" VerticalOptions="End" HorizontalOptions="Center" Spacing="6">
                            <Label Text="🙂" FontSize="16" HorizontalOptions="Center" />
                            <Border BackgroundColor="{StaticResource Primary}" HeightRequest="85" WidthRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 6" HorizontalOptions="Center" />
                            <Label Text="Fri" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="5" VerticalOptions="End" HorizontalOptions="Center" Spacing="6">
                            <Label Text="😁" FontSize="16" HorizontalOptions="Center" />
                            <Border BackgroundColor="#00E676" HeightRequest="115" WidthRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 6" HorizontalOptions="Center" />
                            <Label Text="Sat" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="6" VerticalOptions="End" HorizontalOptions="Center" Spacing="6">
                            <Label Text="😁" FontSize="16" HorizontalOptions="Center" />
                            <Border BackgroundColor="#00E676" HeightRequest="120" WidthRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 6" HorizontalOptions="Center" />
                            <Label Text="Sun" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource SectionTitle}" Text="Mood Breakdown" Margin="0,10,0,8" />
            <Border Style="{StaticResource GlassCard}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="😁 Happy (55%)" FontSize="13" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}" VerticalOptions="Center" WidthRequest="110" />
                        <ProgressBar Grid.Column="1" Progress="0.55" ProgressColor="#00E676" VerticalOptions="Center" HeightRequest="8" />
                        <Label Grid.Column="2" Text="8 days" Style="{StaticResource MutedText}" FontSize="12" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="🙂 Good (25%)" FontSize="13" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}" VerticalOptions="Center" WidthRequest="110" />
                        <ProgressBar Grid.Column="1" Progress="0.25" ProgressColor="{StaticResource Primary}" VerticalOptions="Center" HeightRequest="8" />
                        <Label Grid.Column="2" Text="4 days" Style="{StaticResource MutedText}" FontSize="12" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="😐 Neutral (15%)" FontSize="13" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}" VerticalOptions="Center" WidthRequest="110" />
                        <ProgressBar Grid.Column="1" Progress="0.15" ProgressColor="#FFB800" VerticalOptions="Center" HeightRequest="8" />
                        <Label Grid.Column="2" Text="2 days" Style="{StaticResource MutedText}" FontSize="12" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="😞 Low (5%)" FontSize="13" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}" VerticalOptions="Center" WidthRequest="110" />
                        <ProgressBar Grid.Column="1" Progress="0.05" ProgressColor="#FF5C5C" VerticalOptions="Center" HeightRequest="8" />
                        <Label Grid.Column="2" Text="1 day" Style="{StaticResource MutedText}" FontSize="12" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
