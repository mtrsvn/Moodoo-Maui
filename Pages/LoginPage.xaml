<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MoodooApp.ViewModels"
             x:Class="MoodooApp.Pages.LoginPage"
             x:DataType="viewmodel:LoginViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="Welcome to Moodoo"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Log in to continue"
                FontSize="15"
                HorizontalOptions="Center"
                TextColor="Gray" />

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Email"
                    FontAttributes="Bold" />

                <Entry
                    Placeholder="Enter your email"
                    Keyboard="Email"
                    Text="{Binding Email}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Password"
                    FontAttributes="Bold" />

                <Entry
                    Placeholder="Enter your password"
                    IsPassword="True"
                    Text="{Binding Password}" />
            </VerticalStackLayout>

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red"
                FontSize="13"
                HorizontalOptions="Center" />

            <Button
                Text="Log In"
                Command="{Binding LoginCommand}"
                HeightRequest="50"
                CornerRadius="12" />

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="4">

                <Label
                    Text="Don't have an account?"
                    FontSize="13"
                    TextColor="Gray" />

                <Label
                    Text="Sign Up"
                    FontSize="13"
                    TextColor="Blue"
                    FontAttributes="Bold">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding SignUpCommand}" />
                    </Label.GestureRecognizers>

                </Label>

            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

