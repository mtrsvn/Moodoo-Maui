<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MoodooApp.ViewModels"
             xmlns:models="clr-namespace:MoodooApp.Models"
             xmlns:converters="clr-namespace:MoodooApp.Converters"
             x:Class="MoodooApp.Pages.InsightsPage"
             x:DataType="viewmodel:InsightsViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,36,20,90" Spacing="0">

            <!-- Header with Title & Date Chooser -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Style="{StaticResource HeaderTitle}" Text="Mood Insights" />
                    <Label Style="{StaticResource SubTitle}" Text="Trends &amp; patterns over time" />
                </VerticalStackLayout>

                <!-- Native Modern Date Chooser for Insights -->
                <Border Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light=#F0EFF6, Dark=#252538}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        Padding="12,6"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="&#xe8df;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <DatePicker Date="{Binding SelectedDate, Mode=TwoWay}"
                                    Format="MMMM yyyy"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Metric Summary Cards (No score system, pure qualitative insights) -->
            <Grid ColumnDefinitions="*,12,*,12,*" Margin="0,0,0,16">
                <Border Grid.Column="0" Style="{StaticResource SmallCard}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="&#xe873;" FontFamily="MaterialIcons" FontSize="20" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                        <Label Text="{Binding TotalLogsCount}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}" HorizontalOptions="Center" />
                        <Label Text="Total Logs" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SmallCard}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="&#xe8dc;" FontFamily="MaterialIcons" FontSize="20" TextColor="#00E676" HorizontalOptions="Center" />
                        <Label Text="{Binding PositivePercentage, StringFormat='{0}%'}" FontSize="20" FontAttributes="Bold" TextColor="#00E676" HorizontalOptions="Center" />
                        <Label Text="Positive" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource SmallCard}">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="&#xe87d;" FontFamily="MaterialIcons" FontSize="20" TextColor="#FFB800" HorizontalOptions="Center" />
                        <Label Text="{Binding TopMood}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}" HorizontalOptions="Center" />
                        <Label Text="Top Mood" Style="{StaticResource MutedText}" FontSize="11" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- 7-Day Flow (Horizontal Flow Cards with tap-to-inspect interaction) -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="16,14">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Style="{StaticResource SectionTitle}" Text="7-Day Flow" Margin="0" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding TimeframeTitle}" Style="{StaticResource MutedText}" FontSize="12" VerticalOptions="Center" />
                    </Grid>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding WeeklyStats}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:DayMoodStat">
                                    <Border BackgroundColor="{Binding IsSelected, Converter={StaticResource CalendarSelectedBgConverter}}"
                                            Stroke="{Binding ColorHex}"
                                            StrokeThickness="{Binding IsSelected, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter=2}"
                                            StrokeShape="RoundRectangle 14"
                                            WidthRequest="62"
                                            HeightRequest="88"
                                            Padding="4,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:InsightsViewModel}}, Path=SelectDayFlowCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding DayName}" FontSize="11" FontAttributes="Bold"
                                                   TextColor="{Binding IsSelected, Converter={StaticResource CalendarSelectedDayTextConverter}}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Emoji}" FontSize="22" HorizontalOptions="Center" Margin="0,2" />
                                            <Label Text="{Binding MoodText}" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{Binding IsSelected, Converter={StaticResource CalendarSelectedDayTextConverter}}"
                                                   HorizontalOptions="Center" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <!-- Interactive Mood Breakdown Section -->
            <Label Style="{StaticResource SectionTitle}" Text="Monthly Mood Breakdown" Margin="0,4,0,2" />
            <Label Text="Tap any mood category to filter logs below" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,8" />
            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,16">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MoodBreakdown}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodel:MoodBreakdownItem">
                            <Border BackgroundColor="{Binding IsSelected, Converter={StaticResource CalendarSelectedBgConverter}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="8,6">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:InsightsViewModel}}, Path=FilterByMoodCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6" WidthRequest="110" VerticalOptions="Center">
                                        <Label Text="{Binding Emoji}" FontSize="16" VerticalOptions="Center" />
                                        <Label Text="{Binding MoodLabel}" FontSize="13" FontAttributes="Bold"
                                               TextColor="{Binding IsSelected, Converter={StaticResource CalendarSelectedDayTextConverter}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <ProgressBar Grid.Column="1" Progress="{Binding Percentage}" ProgressColor="{Binding ProgressColor}" VerticalOptions="Center" HeightRequest="8" />
                                    <Label Grid.Column="2" Text="{Binding DaysText}"
                                           TextColor="{Binding IsSelected, Converter={StaticResource CalendarSelectedDayTextConverter}}"
                                           FontSize="12" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>


            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,8" VerticalOptions="Center">
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <Label Text="&#xe873;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <Label Style="{StaticResource SectionTitle}" Text="{Binding SelectedFilterTitle}" FontSize="15" Margin="0" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenHistoryCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="See more" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <Label Text="&#xe5cc;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredLogs}" Spacing="8" Margin="0,0,0,14" IsVisible="{Binding HasFilteredLogs}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:MoodEntry">
                        <Border Style="{StaticResource SmallCard}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:InsightsViewModel}}, Path=OpenMoodDetailCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" BackgroundColor="#267E66EF" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8" WidthRequest="44" HeightRequest="44">
                                    <Label Text="{Binding Emoji}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Mood}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}" />
                                    <Label Text="{Binding Thoughts, TargetNullValue='No written notes'}" FontSize="12" TextColor="{AppThemeBinding Light=#626262, Dark=#A0A0B8}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Timestamp, StringFormat='{0:MMM dd · h:mm tt}'}" FontSize="11" TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#6B6B8E}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,14" IsVisible="{Binding HasFilteredLogs, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="No entries recorded for this selection." Style="{StaticResource MutedText}" FontSize="13" HorizontalOptions="Center" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
