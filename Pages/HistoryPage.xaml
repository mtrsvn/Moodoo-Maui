<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MoodooApp.ViewModels"
             xmlns:models="clr-namespace:MoodooApp.Models"
             x:Class="MoodooApp.Pages.HistoryPage"
             x:DataType="viewmodel:HistoryViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,36" Spacing="0">

            <!-- Header Section with Back Button -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16" VerticalOptions="Center">
                <Border Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light=#EFEFEF, Dark=#252538}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 20"
                        WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClosePageCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" FontFamily="MaterialIcons" FontSize="20"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center" Spacing="2">
                    <Label Style="{StaticResource HeaderTitle}" Text="Mood History" FontSize="22" />
                    <Label Style="{StaticResource SubTitle}" Text="Interactive calendar &amp; reflections" FontSize="13" />
                </VerticalStackLayout>
            </Grid>

            <!-- Month & Date Chooser Card -->
            <Border Style="{StaticResource GlassCard}" Padding="12,8" Margin="0,0,0,14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light=#F0EFF6, Dark=#252538}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 14"
                            WidthRequest="36" HeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PreviousMonthCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="&#xe5cb;" FontFamily="MaterialIcons" FontSize="20"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <!-- Native Modern Date Chooser Button / Picker -->
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F0EFF6, Dark=#252538}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,4" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="&#xe8df;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            <DatePicker Date="{Binding SelectedDate, Mode=TwoWay}"
                                        Format="MMMM yyyy"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border Grid.Column="2"
                            BackgroundColor="{AppThemeBinding Light=#F0EFF6, Dark=#252538}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 14"
                            WidthRequest="36" HeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NextMonthCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="&#xe5cc;" FontFamily="MaterialIcons" FontSize="20"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Calendar Card -->
            <Border Style="{StaticResource GlassCard}" Padding="16,14" Margin="0,0,0,16">
                <VerticalStackLayout Spacing="12">
                    <!-- Days of Week Header -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,4,0,0">
                        <Label Grid.Column="0" Text="M" Style="{StaticResource MutedText}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="T" Style="{StaticResource MutedText}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="W" Style="{StaticResource MutedText}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="3" Text="T" Style="{StaticResource MutedText}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="4" Text="F" Style="{StaticResource MutedText}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="5" Text="S" Style="{StaticResource MutedText}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="6" Text="S" Style="{StaticResource MutedText}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </Grid>

                    <!-- Calendar Grid of Days with Calculated Representative Emoji -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding DaysInMonth}"
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="SpaceBetween"
                                AlignItems="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:CalendarDayItem">
                                <Border BackgroundColor="{Binding IsSelected, Converter={StaticResource CalendarSelectedBgConverter}}"
                                        Stroke="{Binding IsSelected, Converter={StaticResource CalendarSelectedBorderConverter}}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="42"
                                        HeightRequest="52"
                                        Margin="1,3"
                                        Opacity="{Binding IsCurrentMonth, Converter={StaticResource MonthOpacityConverter}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:HistoryViewModel}}, Path=SelectDayCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding DayNumber}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{Binding IsSelected, Converter={StaticResource CalendarSelectedDayTextConverter}}"
                                               HorizontalOptions="Center" />
                                        <Label Text="{Binding Emoji}"
                                               FontSize="15"
                                               Margin="0,1,0,0"
                                               HorizontalOptions="Center"
                                               IsVisible="{Binding HasMood}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Selected Day Log Detail Section -->
            <HorizontalStackLayout Margin="0,4,0,8" Spacing="8">
                <Label Text="&#xe873;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                <Label Style="{StaticResource SectionTitle}" Text="Day Timeline &amp; Entries" FontSize="16" Margin="0" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- If entry(s) exist for selected day (Supports multiple entries logged on the same day) -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedDayLogs}" Spacing="10" Margin="0,0,0,14" IsVisible="{Binding HasSelectedDayLogs}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:MoodEntry">
                        <Border Style="{StaticResource GlassCard}" Padding="16,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:HistoryViewModel}}, Path=OpenMoodDetailCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="#267E66EF" StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="44" HeightRequest="44">
                                        <Label Text="{Binding Emoji}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Timestamp, StringFormat='{0:h:mm tt · dddd, MMMM dd}'}" Style="{StaticResource MutedText}" FontSize="12" />
                                        <Label Text="{Binding Mood}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="#197E66EF" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4" VerticalOptions="Center">
                                        <Label Text="{Binding Mood}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Thoughts, TargetNullValue='No reflection note entered.'}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#D8D8E5}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- If NO entry for selected day -->
            <Border Style="{StaticResource GlassCard}" Padding="18,16" Margin="0,0,0,14" IsVisible="{Binding HasSelectedDayLogs, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="😶" FontSize="26" HorizontalOptions="Center" />
                    <Label Text="No mood logged for this day." Style="{StaticResource MutedText}" FontSize="13" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
