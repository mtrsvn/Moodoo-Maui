<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MoodooApp.ViewModels"
             xmlns:models="clr-namespace:MoodooApp.Models"
             xmlns:converters="clr-namespace:MoodooApp.Converters"
             x:Class="MoodooApp.Pages.ChatbotPage"
             x:DataType="viewmodel:ChatViewModel"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#0F0F17}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:SenderToColorConverter x:Key="SenderToColorConverter" />
            <converters:SenderToTextColorConverter x:Key="SenderToTextColorConverter" />
            <converters:SenderToAlignmentConverter x:Key="SenderToAlignmentConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" VerticalOptions="Fill" HorizontalOptions="Fill">

        <!-- HEADER -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#171725}"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#262638}"
                StrokeThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Back button -->
                <Border Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#222233}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=Navigation.PopAsync}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;"
                           FontFamily="MaterialIcons"
                           FontSize="20"
                           TextColor="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Title -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label Text="Moodie"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                    <Label Text="Emotional Support &amp; Mindfulness"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#94A3B8}" />
                </VerticalStackLayout>

                <!-- Options -->
                <Border Grid.Column="2"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        WidthRequest="36"
                        HeightRequest="36"
                        VerticalOptions="Center">
                    <Label Text="&#xe5d4;"
                           FontFamily="MaterialIcons"
                           FontSize="20"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#94A3B8}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- MESSAGE STREAM -->
        <ScrollView Grid.Row="1"
                    x:Name="ChatScrollView"
                    VerticalScrollBarVisibility="Default"
                    VerticalOptions="Fill">
            <VerticalStackLayout x:Name="MessagesContainer"
                                 Padding="16,12"
                                 Spacing="14"
                                 MaximumWidthRequest="720"
                                 HorizontalOptions="Center">

                <!-- Prompt Suggestion Pills -->
                <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center" Margin="0,4,0,8">
                    <Border BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1E1E2D}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2D2D3F}"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,8"
                            Margin="4,4">
                        <Label Text="🌱 Breathing exercise" FontSize="12" TextColor="{AppThemeBinding Light=#4B5563, Dark=#CBD5E1}" />
                    </Border>
                    <Border BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1E1E2D}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2D2D3F}"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,8"
                            Margin="4,4">
                        <Label Text="💭 Reflect on my mood" FontSize="12" TextColor="{AppThemeBinding Light=#4B5563, Dark=#CBD5E1}" />
                    </Border>
                    <Border BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1E1E2D}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2D2D3F}"
                            StrokeShape="RoundRectangle 20"
                            Padding="14,8"
                            Margin="4,4">
                        <Label Text="✨ Positive affirmations" FontSize="12" TextColor="{AppThemeBinding Light=#4B5563, Dark=#CBD5E1}" />
                    </Border>
                </FlexLayout>

                <!-- Message Bubbles -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Messages}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatMessage">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
                                <!-- Bot Avatar -->
                                <Border Grid.Column="0"
                                        IsVisible="{Binding IsBot}"
                                        BackgroundColor="#207E66EF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        WidthRequest="30"
                                        HeightRequest="30"
                                        VerticalOptions="Start"
                                        Margin="0,2,10,0">
                                    <Label Text="&#xe0b7;"
                                           FontFamily="MaterialIcons"
                                           FontSize="15"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Bubble -->
                                <Border Grid.Column="1"
                                        Padding="14,10"
                                        BackgroundColor="{Binding Sender, Converter={StaticResource SenderToColorConverter}}"
                                        HorizontalOptions="{Binding Sender, Converter={StaticResource SenderToAlignmentConverter}}"
                                        StrokeShape="RoundRectangle 18"
                                        MaximumWidthRequest="460"
                                        StrokeThickness="0">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Text}"
                                               FontSize="14"
                                               LineHeight="1.3"
                                               TextColor="{Binding Sender, Converter={StaticResource SenderToTextColorConverter}}" />
                                        <Label Text="{Binding Timestamp, StringFormat='{0:h:mm tt}'}"
                                               FontSize="9"
                                               Opacity="0.6"
                                               HorizontalOptions="End"
                                               TextColor="{Binding Sender, Converter={StaticResource SenderToTextColorConverter}}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- User right-side spacer -->
                                <BoxView Grid.Column="2"
                                         IsVisible="{Binding IsUser}"
                                         WidthRequest="4"
                                         Color="Transparent" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Typing indicator -->
                <Border IsVisible="{Binding IsBusy}"
                        HorizontalOptions="Start"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A2A}"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16,10"
                        Margin="40,0,0,0">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView x:Name="Dot1" WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="{StaticResource Primary}" VerticalOptions="Center" />
                        <BoxView x:Name="Dot2" WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="{StaticResource Primary}" VerticalOptions="Center" />
                        <BoxView x:Name="Dot3" WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="{StaticResource Primary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM INPUT BAR -->
        <Border Grid.Row="2"
                BackgroundColor="Transparent"
                StrokeThickness="0"
                Padding="16,8,16,12">
            <VerticalStackLayout Spacing="8">

                <!-- Main Input Pill -->
                <Border BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1E1E2D}"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2D2D3F}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="16,4,8,4"
                        HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <Entry Grid.Column="0"
                               x:Name="MessageEntry"
                               Text="{Binding NewMessage}"
                               Placeholder="Enter message"
                               ReturnType="Send"
                               ReturnCommand="{Binding SendMessageCommand}"
                               PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#64748B}"
                               TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                               BackgroundColor="Transparent"
                               FontSize="15"
                               VerticalOptions="Center" />

                        <!-- Send Button -->
                        <ImageButton Grid.Column="1"
                                     Command="{Binding SendMessageCommand}"
                                     BackgroundColor="{StaticResource Primary}"
                                     WidthRequest="36"
                                     HeightRequest="36"
                                     CornerRadius="18"
                                     Padding="8"
                                     VerticalOptions="Center">
                            <ImageButton.Source>
                                <FontImageSource Glyph="&#xe163;"
                                                 FontFamily="MaterialIcons"
                                                 Size="18"
                                                 Color="#FFFFFF" />
                            </ImageButton.Source>
                        </ImageButton>
                    </Grid>
                </Border>


            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>