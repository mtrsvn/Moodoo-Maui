<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MoodooApp.ViewModels"
             xmlns:models="clr-namespace:MoodooApp.Models"
             x:Class="MoodooApp.Pages.MoodDetailPage"
             x:DataType="viewmodel:MoodDetailViewModel"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,36" Spacing="0">

            <!-- Header with Back button and Delete action -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20" VerticalOptions="Center">
                <Border Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light=#EFEFEF, Dark=#252538}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 20"
                        WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClosePageCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" FontFamily="MaterialIcons" FontSize="20"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#E8E8E8}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center" Spacing="2">
                    <Label Style="{StaticResource HeaderTitle}" Text="Mood Details" FontSize="22" />
                    <Label Text="{Binding MoodEntry.Timestamp, StringFormat='{0:dddd, MMMM dd, yyyy}'}" Style="{StaticResource SubTitle}" FontSize="13" />
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        BackgroundColor="#19FF5C5C"
                        StrokeThickness="0" StrokeShape="RoundRectangle 20"
                        WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeleteLogCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe872;" FontFamily="MaterialIcons" FontSize="20"
                           TextColor="#FF5C5C"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Hero Mood Card -->
            <Border Style="{StaticResource GlassCard}" Padding="20,18" Margin="0,0,0,16">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <Border BackgroundColor="{AppThemeBinding Light=#F5F4FD, Dark=#222233}"
                            Stroke="{Binding MoodColor}" StrokeThickness="2.5"
                            StrokeShape="RoundRectangle 50"
                            WidthRequest="90" HeightRequest="90"
                            HorizontalOptions="Center">
                        <Label Text="{Binding MoodEntry.Emoji, TargetNullValue='😶'}" FontSize="48" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding MoodEntry.Mood}" FontSize="24" FontAttributes="Bold"
                               TextColor="{Binding MoodColor}" HorizontalOptions="Center" />
                        <Label Text="{Binding MoodEntry.Timestamp, StringFormat='Logged at {0:h:mm tt}'}"
                               Style="{StaticResource MutedText}" FontSize="13" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Feelings / Emotion Tags -->
            <VerticalStackLayout Margin="0,4,0,14" Spacing="8">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="&#xe87d;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <Label Style="{StaticResource SectionTitle}" Text="Feelings &amp; Emotions" FontSize="16" Margin="0" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <FlexLayout BindableLayout.ItemsSource="{Binding Tags}"
                            Wrap="Wrap"
                            Direction="Row"
                            AlignItems="Start"
                            AlignContent="Start"
                            Margin="0,4,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border BackgroundColor="#267E66EF"
                                    Stroke="{StaticResource PrimaryLight}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="12,6"
                                    Margin="0,0,8,8">
                                <Label Text="{Binding .}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- Activities & Influencing Factors -->
            <VerticalStackLayout Margin="0,0,0,14" Spacing="8">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="&#xeb4c;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <Label Style="{StaticResource SectionTitle}" Text="Influencing Factors" FontSize="16" Margin="0" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <FlexLayout BindableLayout.ItemsSource="{Binding Activities}"
                            Wrap="Wrap"
                            Direction="Row"
                            AlignItems="Start"
                            AlignContent="Start"
                            Margin="0,4,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border BackgroundColor="#2600E676"
                                    Stroke="#00E676"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="12,6"
                                    Margin="0,0,8,8">
                                <Label Text="{Binding .}" FontSize="12" FontAttributes="Bold" TextColor="#00E676" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- Journal Reflection / Notes Section -->
            <HorizontalStackLayout Margin="0,0,0,8" Spacing="8">
                <Label Text="&#xe865;" FontFamily="MaterialIcons" FontSize="18" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                <Label Style="{StaticResource SectionTitle}" Text="Reflection &amp; Thoughts" FontSize="16" Margin="0" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource GlassCard}" Padding="16,14" Margin="0,0,0,20" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#191924}">
                <Label Text="{Binding MoodEntry.Thoughts, TargetNullValue='No written reflection for this entry.'}"
                       FontSize="14"
                       LineHeight="1.3"
                       TextColor="{AppThemeBinding Light=#2A2A2A, Dark=#E0E0EC}" />
            </Border>

            <!-- Close / Done Button -->
            <Button Style="{StaticResource PrimaryButton}"
                    Text="Done"
                    Command="{Binding ClosePageCommand}"
                    HeightRequest="50"
                    CornerRadius="14" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
