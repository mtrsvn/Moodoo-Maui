<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodooApp.Pages.RegisterPage"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="18"
            VerticalOptions="Center">

            <Label
                Text="Create Account"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Create your Moodoo account"
                FontSize="15"
                TextColor="Gray"
                HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Full Name"
                    FontAttributes="Bold" />

                <Entry
                    Placeholder="Enter your full name"
                    Text="{Binding FullName}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Username"
                    FontAttributes="Bold" />

                <Entry
                    Placeholder="Enter your username"
                    Text="{Binding Username}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Email"
                    FontAttributes="Bold" />

                <Entry
                    Placeholder="Enter your email"
                    Keyboard="Email"
                    Text="{Binding Email}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Password"
                    FontAttributes="Bold" />

                <Entry
                    Placeholder="Create a password"
                    IsPassword="True"
                    Text="{Binding Password}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Confirm Password"
                    FontAttributes="Bold" />

                <Entry
                    Placeholder="Confirm your password"
                    IsPassword="True"
                    Text="{Binding ConfirmPassword}" />
            </VerticalStackLayout>

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red"
                FontSize="13"
                HorizontalOptions="Center" />

            <Button
                Text="Create Account"
                Command="{Binding RegisterCommand}"
                HeightRequest="50"
                CornerRadius="12" />

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="4">

                <Label
                    Text="Already have an account?"
                    FontSize="13"
                    TextColor="Gray" />

                <Label
                    Text="Log In"
                    FontSize="13"
                    TextColor="Blue"
                    FontAttributes="Bold">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding BackToLoginCommand}" />
                    </Label.GestureRecognizers>

                </Label>

            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
